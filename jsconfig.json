{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "app/**/*", "components/**/*", "next-env.d.ts"],
  "exclude": ["node_modules", ".next"]
}